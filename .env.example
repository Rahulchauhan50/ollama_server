# Server Configuration
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/ollama

# JWT Secrets (change in production!)
JWT_ACCESS_SECRET=your-access-secret-min-8-characters
JWT_REFRESH_SECRET=your-refresh-secret-min-8-characters

# Ollama Integration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL_DEFAULT=llama2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
ALLOWED_CHAT_MODELS=llama2,neural-chat,mistral

# Legacy / Optional
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_USERNAME=
OLLAMA_PASSWORD=

