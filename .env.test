# Test Environment Configuration
PORT=3000
NODE_ENV=test

# Test Database (MongoDB test instance or memory mock)
MONGODB_URI=mongodb+srv://admin:adminuser@assets.odsgx.mongodb.net/ollama-test

# JWT Secrets (test values)
JWT_ACCESS_SECRET=test-access-secret-12345
JWT_REFRESH_SECRET=test-refresh-secret-12345

# Ollama Integration (test mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL_DEFAULT=llama2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
